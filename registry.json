{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "metro",
  "homepage": "https://github.com/mflkee/metro-ui",
  "items": [
    {
      "name": "metro-theme",
      "type": "registry:file",
      "title": "Metro theme",
      "description": "Brand design tokens for the metro fleet: light + dark, Geist font, semantic colors.",
      "dependencies": [
        "@fontsource-variable/geist"
      ],
      "files": [
        {
          "path": "registry/metro-theme/metro-theme.css",
          "type": "registry:file",
          "target": "src/metro-theme.css"
        }
      ],
      "docs": "Add this to `src/index.css`, right after `@import \"tailwindcss\";`:\n\n```css\n@import \"./metro-theme.css\";\n```"
    },
    {
      "name": "theme-provider",
      "type": "registry:component",
      "title": "Theme provider",
      "description": "next-themes provider with class strategy (light/dark/system).",
      "dependencies": [
        "next-themes"
      ],
      "files": [
        {
          "path": "registry/theme-provider/theme-provider.tsx",
          "type": "registry:component",
          "target": "@components/theme-provider.tsx"
        }
      ]
    },
    {
      "name": "theme-toggle",
      "type": "registry:component",
      "title": "Theme toggle",
      "description": "Light / dark / system switcher.",
      "dependencies": [
        "next-themes",
        "lucide-react"
      ],
      "registryDependencies": [
        "button",
        "dropdown-menu"
      ],
      "files": [
        {
          "path": "registry/theme-toggle/theme-toggle.tsx",
          "type": "registry:component",
          "target": "@components/theme-toggle.tsx"
        }
      ]
    },
    {
      "name": "status-badge",
      "type": "registry:component",
      "title": "Status badge",
      "description": "Tone-based status badge built on semantic theme tokens.",
      "dependencies": [
        "class-variance-authority"
      ],
      "registryDependencies": [
        "badge"
      ],
      "files": [
        {
          "path": "registry/status-badge/status-badge.tsx",
          "type": "registry:component",
          "target": "@components/status-badge.tsx"
        }
      ]
    },
    {
      "name": "stat-card",
      "type": "registry:component",
      "title": "Stat card",
      "description": "Metric card for dashboards.",
      "registryDependencies": [
        "card"
      ],
      "files": [
        {
          "path": "registry/stat-card/stat-card.tsx",
          "type": "registry:component",
          "target": "@components/stat-card.tsx"
        }
      ]
    },
    {
      "name": "page-header",
      "type": "registry:component",
      "title": "Page header",
      "description": "Page title, description and action slot.",
      "files": [
        {
          "path": "registry/page-header/page-header.tsx",
          "type": "registry:component",
          "target": "@components/page-header.tsx"
        }
      ]
    },
    {
      "name": "app-shell",
      "type": "registry:block",
      "title": "App shell",
      "description": "Sidebar + topbar + content layout built on the shadcn sidebar primitive.",
      "dependencies": [
        "lucide-react",
        "react-router-dom"
      ],
      "registryDependencies": [
        "sidebar",
        "button",
        "separator",
        "tooltip"
      ],
      "files": [
        {
          "path": "registry/app-shell/app-shell.tsx",
          "type": "registry:block",
          "target": "@components/app-shell.tsx"
        }
      ]
    }
  ]
}
